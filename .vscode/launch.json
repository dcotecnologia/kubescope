{
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "linux": {
                "env": {
                    "LD_LIBRARY_PATH": "${workspaceFolder}/vendor/linux/x86_64:${env:LD_LIBRARY_PATH}"
                },
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "name": "KubeScope",
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "program": "${workspaceFolder}/main.py",
            "request": "launch",
            "type": "debugpy",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        },
        {
            "cwd": "${workspaceFolder}",
            "justMyCode": true,
            "linux": {
                "env": {
                    "LD_LIBRARY_PATH": "${workspaceFolder}/vendor/linux/x86_64:${env:LD_LIBRARY_PATH}"
                },
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "name": "KubeScope preview (fake data)",
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "program": "${workspaceFolder}/tools/preview.py",
            "request": "launch",
            "type": "debugpy",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        },
        {
            "args": [
                "${file}",
                "-q",
                "--no-cov"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "QT_QPA_PLATFORM": "offscreen"
            },
            "justMyCode": false,
            "linux": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "module": "pytest",
            "name": "Pytest: current file",
            "osx": {
                "python": "${workspaceFolder}/.venv/bin/python"
            },
            "request": "launch",
            "type": "debugpy",
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            }
        }
    ],
    "version": "0.2.0"
}

            "CONTEXT NAMES": "\u4e0a\u4e0b\u6587\u540d\u79f0",
            "Check GitHub for a new version when the app starts": "\u5e94\u7528\u542f\u52a8\u65f6\u5728 GitHub \u4e0a\u68c0\u67e5\u65b0\u7248\u672c",
            "Clear the cache": "\u6e05\u9664\u7f13\u5b58",

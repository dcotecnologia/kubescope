        "Errors": {
            "Access denied": "\u8bbf\u95ee\u88ab\u62d2\u7edd",
            "Authentication failed": "\u8eab\u4efd\u9a8c\u8bc1\u5931\u8d25",
            "Check your internet connection or VPN and refresh.": "\u8bf7\u68c0\u67e5\u7f51\u7edc\u8fde\u63a5\u6216 VPN \u540e\u5237\u65b0\u3002",
            "Check your network or VPN and that the cluster is running.": "\u8bf7\u68c0\u67e5\u60a8\u7684\u7f51\u7edc\u6216 VPN\uff0c\u5e76\u786e\u8ba4\u96c6\u7fa4\u6b63\u5728\u8fd0\u884c\u3002",
            "Cluster unreachable": "\u65e0\u6cd5\u8fde\u63a5\u96c6\u7fa4",
            "Context not found": "\u672a\u627e\u5230\u4e0a\u4e0b\u6587",
            "Login tool not found": "\u672a\u627e\u5230\u767b\u5f55\u5de5\u5177",
            "No network connection": "\u6ca1\u6709\u7f51\u7edc\u8fde\u63a5",
            "Node Groups, Add-ons and the AWS cards of the Overview exist only on Amazon EKS contexts.": "Node Groups\u3001Add-ons \u4ee5\u53ca\u6982\u89c8\u4e2d\u7684 AWS \u5361\u7247\u4ec5\u5b58\u5728\u4e8e Amazon EKS \u4e0a\u4e0b\u6587\u3002",
            "Not an Amazon EKS cluster": "\u4e0d\u662f Amazon EKS \u96c6\u7fa4",
            "Something went wrong": "\u51fa\u4e86\u70b9\u95ee\u9898",
            "This context is not in your kubeconfig. Check ~/.kube/config.": "\u6b64\u4e0a\u4e0b\u6587\u4e0d\u5728\u60a8\u7684 kubeconfig \u4e2d\u3002\u8bf7\u68c0\u67e5 ~/.kube/config\u3002",
            "Unexpected answer from AWS": "AWS \u8fd4\u56de\u4e86\u610f\u5916\u7684\u54cd\u5e94",
            "Update the AWS CLI to its latest version and refresh.": "\u8bf7\u5c06 AWS CLI \u66f4\u65b0\u5230\u6700\u65b0\u7248\u672c\u540e\u5237\u65b0\u3002",
            "Your AWS identity is not allowed to read this. The wiki lists the eks: permissions KubeScope needs.": "\u60a8\u7684 AWS \u8eab\u4efd\u65e0\u6743\u8bfb\u53d6\u6b64\u5185\u5bb9\u3002Wiki \u5217\u51fa\u4e86 KubeScope \u6240\u9700\u7684 eks: \u6743\u9650\u3002",
            "Your credentials may have expired. Sign in again (for example \u201caws sso login\u201d, \u201cgcloud auth login\u201d or \u201caz login\u201d) and refresh.": "\u60a8\u7684\u51ed\u636e\u53ef\u80fd\u5df2\u8fc7\u671f\u3002\u8bf7\u91cd\u65b0\u767b\u5f55\uff08\u4f8b\u5982\u4f7f\u7528\u201caws sso login\u201d\u3001\u201cgcloud auth login\u201d\u6216\u201caz login\u201d\uff09\u540e\u5237\u65b0\u3002",
            "Your kubeconfig runs \u201c{tool}\u201d to sign in, but it is not installed or not on the PATH. Install it and refresh.": "\u60a8\u7684 kubeconfig \u8fd0\u884c\u201c{tool}\u201d\u6765\u767b\u5f55\uff0c\u4f46\u5b83\u6ca1\u6709\u5b89\u88c5\u6216\u4e0d\u5728 PATH \u4e2d\u3002\u8bf7\u5b89\u88c5\u540e\u5237\u65b0\u3002",
            "Your user is not allowed to read this resource.": "\u60a8\u7684\u7528\u6237\u65e0\u6743\u8bfb\u53d6\u6b64\u8d44\u6e90\u3002"
        },
        "LogTab": {
            "Auto-refresh": "\u81ea\u52a8\u5237\u65b0",

    "strings": {
        "Errors": {
            "Access denied": "\u30a2\u30af\u30bb\u30b9\u304c\u62d2\u5426\u3055\u308c\u307e\u3057\u305f",
            "Authentication failed": "\u8a8d\u8a3c\u306b\u5931\u6557\u3057\u307e\u3057\u305f",
            "Check your internet connection or VPN and refresh.": "\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u63a5\u7d9a\u307e\u305f\u306f VPN \u3092\u78ba\u8a8d\u3057\u3066\u3001\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Check your network or VPN and that the cluster is running.": "\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u307e\u305f\u306f VPN \u3068\u3001\u30af\u30e9\u30b9\u30bf\u30fc\u304c\u7a3c\u50cd\u3057\u3066\u3044\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Cluster unreachable": "\u30af\u30e9\u30b9\u30bf\u30fc\u306b\u63a5\u7d9a\u3067\u304d\u307e\u305b\u3093",
            "Context not found": "\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093",
            "Login tool not found": "\u30ed\u30b0\u30a4\u30f3\u30c4\u30fc\u30eb\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093",
            "No network connection": "\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093",
            "Node Groups, Add-ons and the AWS cards of the Overview exist only on Amazon EKS contexts.": "Node Groups\u3001Add-ons\u3001\u6982\u8981\u306e AWS \u30ab\u30fc\u30c9\u306f Amazon EKS \u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u306b\u306e\u307f\u5b58\u5728\u3057\u307e\u3059\u3002",
            "Not an Amazon EKS cluster": "Amazon EKS \u30af\u30e9\u30b9\u30bf\u30fc\u3067\u306f\u3042\u308a\u307e\u305b\u3093",
            "Something went wrong": "\u554f\u984c\u304c\u767a\u751f\u3057\u307e\u3057\u305f",
            "This context is not in your kubeconfig. Check ~/.kube/config.": "\u3053\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u306f kubeconfig \u306b\u3042\u308a\u307e\u305b\u3093\u3002~/.kube/config \u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Unexpected answer from AWS": "AWS \u304b\u3089\u306e\u4e88\u671f\u3057\u306a\u3044\u5fdc\u7b54",
            "Update the AWS CLI to its latest version and refresh.": "AWS CLI \u3092\u6700\u65b0\u7248\u306b\u66f4\u65b0\u3057\u3066\u3001\u518d\u8aad\u307f\u8fbc\u307f\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Your AWS identity is not allowed to read this. The wiki lists the eks: permissions KubeScope needs.": "\u3053\u306e AWS ID \u306b\u306f\u8aad\u307f\u53d6\u308a\u6a29\u9650\u304c\u3042\u308a\u307e\u305b\u3093\u3002KubeScope \u306b\u5fc5\u8981\u306a eks: \u6a29\u9650\u306f Wiki \u306b\u8a18\u8f09\u3055\u308c\u3066\u3044\u307e\u3059\u3002",
            "Your credentials may have expired. Sign in again (for example \u201caws sso login\u201d, \u201cgcloud auth login\u201d or \u201caz login\u201d) and refresh.": "\u8a8d\u8a3c\u60c5\u5831\u306e\u6709\u52b9\u671f\u9650\u304c\u5207\u308c\u305f\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u3082\u3046\u4e00\u5ea6\u30b5\u30a4\u30f3\u30a4\u30f3\u3057\u3066\uff08\u4f8b\uff1a\u300caws sso login\u300d\u300cgcloud auth login\u300d\u300caz login\u300d\uff09\u3001\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Your kubeconfig runs \u201c{tool}\u201d to sign in, but it is not installed or not on the PATH. Install it and refresh.": "kubeconfig \u306f\u30b5\u30a4\u30f3\u30a4\u30f3\u306b\u300c{tool}\u300d\u3092\u5b9f\u884c\u3057\u307e\u3059\u304c\u3001\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u306a\u3044\u304b PATH \u306b\u3042\u308a\u307e\u305b\u3093\u3002\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304b\u3089\u66f4\u65b0\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
            "Your user is not allowed to read this resource.": "\u3053\u306e\u30e6\u30fc\u30b6\u30fc\u306b\u306f\u3053\u306e\u30ea\u30bd\u30fc\u30b9\u3092\u8aad\u307f\u53d6\u308b\u6a29\u9650\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
        },

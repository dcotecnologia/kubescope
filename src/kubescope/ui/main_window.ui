  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget#page { background: #f7f7fa; color: #20232a; }
QWidget#topBar { background: #06234a; }
QLabel#topBrand {
    color: #ffffff; font-size: 13px; font-weight: 700;
    padding: 0 12px; background: #123764; min-height: 46px;
}
QFrame[pinTab="true"] { background: transparent; border: 0; border-top: 2px solid transparent; }
QFrame[pinTab="true"][active="true"] { background: #123764; border-top: 2px solid #6252b5; }
QFrame#dropMarker { background: #6252b5; border-radius: 1px; }
QFrame[pinTab="true"] QPushButton {
    color: #b8c7dc; background: transparent; border: 0; padding: 6px 4px;
    font-size: 12px; font-weight: 600;
}
QFrame[pinTab="true"] QPushButton:hover, QFrame[pinTab="true"][active="true"] QPushButton { color: #ffffff; }
QFrame[pinTab="true"] QPushButton[closeTab="true"] { font-size: 16px; padding: 2px 6px; }
QLabel#topTitle { color: #ffffff; font-size: 14px; font-weight: 700; }
QLabel#topSubtitle { color: #b8c7dc; font-size: 9px; }
QLabel#topCaption { color: #b8c7dc; font-size: 9px; font-weight: 700; }
QPushButton#settingsButton {
    background: transparent; border: 1px solid transparent; border-radius: 4px;
    padding: 0;
}
QPushButton#settingsButton:hover { background: #0d315d; }
QPushButton#settingsButton:checked { background: #1f4f87; }
QComboBox#contextCombo {
    background: #0d315d; color: #ffffff; border: 1px solid #2d5077;
    border-radius: 4px; min-height: 30px; padding: 0 9px; font-size: 11px;
}
QWidget#sidebar { background: #ffffff; border-right: 1px solid #e1e3e9; }
QScrollArea#sidebarScroll, QWidget#sidebarNav { background: transparent; border: 0; }
QLabel#navSection, QLabel#filterLabel {
    color: #535d69; font-size: 9px; font-weight: 700;
}
QFrame#sidebarRule { color: #e6e7ed; }
QLabel#sidebarNote { color: #4d5866; font-size: 10px; line-height: 1.4; }
QWidget#pageHeader { background: #ffffff; border-bottom: 1px solid #e4e5eb; }
QLabel#pageTitle { color: #17191e; font-size: 16px; font-weight: 700; }
QLabel[variant="muted"] { color: #4f5966; font-size: 11px; }
QComboBox[variant="filter"], QLineEdit#searchInput, QPushButton[variant="primary"] {
    background: #ffffff; border: 1px solid #d9dce4; border-radius: 5px;
    min-height: 36px; padding: 0 10px; font-size: 11px;
}
QComboBox[variant="filter"], QLineEdit#searchInput {
    color: #20232a; selection-background-color: #d9d3f2;
    selection-color: #20232a;
}
QComboBox[variant="filter"] { padding-right: 28px; }
QComboBox[variant="filter"]:hover { border-color: #b9b3dc; }
QComboBox[variant="filter"]:focus, QComboBox[variant="filter"]:on,
QLineEdit#searchInput:focus { border: 1px solid #6252b5; }
QComboBox[variant="filter"]::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 26px; border: 0; background: transparent;
}
QComboBox[variant="filter"]::down-arrow {
    image: url(CHEVRON); width: 10px; height: 6px; margin-right: 8px;
}
QComboBox[variant="filter"] QAbstractItemView {
    background: #ffffff; color: #20232a; border: 1px solid #d9dce4;
    selection-background-color: #eee9f7; selection-color: #3220a0;
    outline: 0; padding: 2px;
}
QComboBox[variant="filter"]:disabled {
    color: #6b7380; background: #f3f4f7; border-color: #e4e5eb;
}
QComboBox#contextCombo:disabled { color: #ffffff; }
QComboBox#contextCombo { padding-right: 28px; }
QComboBox#contextCombo::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 26px; border: 0; background: transparent;
}
QComboBox#contextCombo::down-arrow {
    image: url(CHEVRON_LIGHT); width: 10px; height: 6px; margin-right: 8px;
}
QComboBox#contextCombo QAbstractItemView {
    background: #0d315d; color: #ffffff; border: 1px solid #2d5077;
    selection-background-color: #1f4f87; selection-color: #ffffff;
    outline: 0; padding: 2px;
}
QPushButton[variant="primary"] {
    background: #3020a5; color: #ffffff; border: 0;
    font-weight: 700; padding: 0 16px;
}
QPushButton[variant="primary"]:hover { background: #4030b8; }
QPushButton[variant="primary"]:disabled { background: #6c5fc4; color: #ffffff; }
QPushButton[variant="link"] {
  border: none; background: transparent; padding: 2px 0; text-align: left;
  color: #3220a0; font-weight: 600; text-decoration: underline;
}
QPushButton[variant="link"]:hover { color: #4030b8; }
QPushButton[variant="link"]:disabled { color: #4f5966; text-decoration: none; }
QScrollArea { background: transparent; border: 0; }
QWidget#settingsContent, QWidget#overviewContent { background: transparent; }
QPushButton[variant="secondary"] {
    background: #ffffff; color: #3220a0; border: 1px solid #d9dce4;
    border-radius: 5px; min-height: 32px; padding: 0 10px;
    font-size: 11px; font-weight: 600;
}
QPushButton[variant="secondary"]:hover:enabled {
    background: #f3f1f9; border-color: #a9a0d6;
}
QPushButton[variant="secondary"]:disabled { color: #7b8089; }
QPushButton[iconOnly="true"] {
    padding: 0; min-width: 36px; max-width: 36px;
}
QLabel#summaryLabel { color: #4f5966; font-size: 11px; font-weight: 600; }
QTableWidget[variant="data"] {
    background: #ffffff; color: #242a33;
    border: 1px solid #dfe2e9; border-radius: 5px;
    gridline-color: #e8e9ee; selection-background-color: #f0edfa;
    selection-color: #28213f;
}
QHeaderView { background: #fbfbfc; }
QHeaderView::up-arrow { image: url(SORT_UP); width: 9px; height: 6px; }
QHeaderView::down-arrow { image: url(SORT_DOWN); width: 9px; height: 6px; }
QHeaderView::section {
    background: #fbfbfc; color: #3c4149; border: 0;
    border-bottom: 1px solid #dfe2e9; padding: 10px 11px;
    font-size: 9px; font-weight: 700;
}
QTableWidget[variant="data"]::item {
    padding: 6px 8px; border-bottom: 1px solid #e8e9ee;
}
QPushButton[nav="true"] {
    text-align: left; color: #4f5966; background: transparent;
    border: 0; border-right: 3px solid transparent; border-radius: 0;
    padding: 0 12px; font-size: 12px; font-weight: 600;
}
QPushButton[nav="true"]:hover { background: #f6f6fa; }
QPushButton[nav="true"]:checked {
    color: #3220a0; background: #f3f1f9; border-right: 3px solid #3220a0;
    font-weight: 700;
}
QFrame[card="true"] {
    background: #ffffff; border: 1px solid #dfe2e9; border-radius: 8px;
}
QFrame[card="true"] QLabel { background: transparent; border: 0; }
QLabel[variant="cardTitle"] { color: #535d69; font-size: 9px; font-weight: 700; }
QLabel[variant="cardValue"] { color: #17191e; font-size: 20px; font-weight: 700; }
QLabel[variant="cardCaption"] { color: #4f5966; font-size: 10px; }
QProgressBar {
    background: #eceef3; border: 0; border-radius: 3px;
    min-height: 6px; max-height: 6px;
}
QProgressBar::chunk { background: #6252b5; border-radius: 3px; }
QProgressBar[level="warn"]::chunk { background: #d58a2b; }
QProgressBar[level="high"]::chunk { background: #c9484f; }
QCheckBox { color: #20232a; spacing: 8px; font-size: 11px; }
QLabel { color: #20232a; }
QTabBar { qproperty-drawBase: 0; }
QTabWidget::pane { border: 0; border-top: 1px solid #dfe2e9; top: -1px; }
QTabBar::tab {
    background: transparent; color: #4f5966; padding: 9px 14px;
    border: 0; border-bottom: 2px solid transparent; font-size: 11px;
    font-weight: 600; max-width: 260px;
}
QTabBar::tab:hover { color: #3220a0; }
QTabBar::tab:selected { color: #3220a0; border-bottom: 2px solid #3220a0; }
QTabBar::close-button {
    image: url(CLOSE_ICON); subcontrol-position: right; margin-left: 6px;
    width: 10px; height: 10px; padding: 3px; border-radius: 4px;
}
QTabBar::close-button:hover { image: url(CLOSE_ICON_HOVER); background: #eee9f7; }
QPlainTextEdit {
    background: #ffffff; color: #242a33; border: 1px solid #dfe2e9;
    border-radius: 5px; padding: 8px; selection-background-color: #d9d3f2;
    selection-color: #20232a;
}
QFrame#noContextsBanner { background: #fff2de; border-bottom: 1px solid #985415; }
QFrame#noContextsBanner QLabel { color: #985415; font-size: 11px; background: transparent; }
QFrame#permissionBanner { background: #fce9ea; border-bottom: 1px solid #a33d45; }
QFrame#permissionBanner QLabel { color: #a33d45; font-size: 11px; background: transparent; }
QFrame#permissionBanner QPushButton { color: #a33d45; font-size: 11px; padding: 0 0 0 12px; }
QFrame#appFooter { background: #ffffff; border-top: 1px solid #e4e5eb; }
QLabel#footerLicense, QLabel#footerDot, QLabel#footerVersion, QLabel#updateNotice { color: #6b7380; font-size: 10px; }
QFrame#appFooter QPushButton[variant="link"] { font-size: 10px; padding: 0 0 0 6px; }
QPushButton#companyLink, QPushButton#licenseLink { padding: 0; }
QPushButton#updateButton { border: none; background: transparent; padding: 0; border-radius: 4px; }
QPushButton#updateButton:hover { background: #f6f6fa; }

{
  "folders": [
    {
      "path": ".",
    },
    {
      "path": "../kubescope-aws",
    },
    {
      "path": "../kubescope-gabi",
    },
    {
      "path": "../kubescope-sdk",
    },
    {
      "path": "../kubescope-search",
    },
    {
      "path": "../kubescope-themes",
    },
  ],
  "settings": {
    // ── Editor ────────────────────────────────────────────────────────────
    "editor.foldingImportsByDefault": true,
    "editor.formatOnSave": true,
    "editor.inlineSuggest.enabled": true,
    "editor.minimap.enabled": false,
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true,
    },
    "editor.renderWhitespace": "boundary",
    "editor.rulers": [80, 160],
    "editor.suggestOnTriggerCharacters": true,
    "editor.wordBasedSuggestions": "matchingDocuments",
    "files.autoSave": "onFocusChange",
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // ── Per-language formatters ───────────────────────────────────────────
    "[jsonc]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
      "editor.insertSpaces": true,
      "editor.tabSize": 4,
    },
    "[markdown]": {
      "editor.codeActionsOnSave": {
        "source.fixAll.markdownlint": "explicit",
      },
    },
    "[python]": {
      "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit",
      },
      "editor.defaultFormatter": "charliermarsh.ruff",
      "editor.formatOnSave": true,
      "editor.insertSpaces": true,
      "editor.tabSize": 4,
    },
    "[shellscript]": {
      "editor.defaultFormatter": "mkhl.shfmt",
    },
    "[toml]": {
      "editor.defaultFormatter": "tamasfe.even-better-toml",
    },
    "[typescript]": {
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
      },
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[vue]": {
      "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
      },
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[yaml]": {
      "editor.defaultFormatter": "esbenp.prettier-vscode",
    },

    // ── Python ────────────────────────────────────────────────────────────
    // Each module has its own .venv; Pylance resolves it per folder.
    "python.analysis.autoImportCompletions": true,
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.diagnosticSeverityOverrides": {
      "reportMissingModuleSource": "none",
      "reportMissingParameterType": "none",
      "reportMissingTypeStubs": "none",
      "reportUnknownArgumentType": "none",
      "reportUnknownLambdaType": "none",
      "reportUnknownMemberType": "none",
      "reportUnknownParameterType": "none",
      "reportUnknownVariableType": "none",
      "reportUntypedFunctionDecorator": "none",
    },
    "python.analysis.exclude": [
      "**/*.egg-info",
      "**/.git",
      "**/.mypy_cache",
      "**/.pytest_cache",
      "**/.ruff_cache",
      "**/.venv",
      "**/__pycache__",
      "**/build",
      "**/dist",
      "**/node_modules",
      "**/vendor",
    ],
    // the biggest packages are indexed one level deep: PySide6 alone has
    // thousands of modules
    "python.analysis.packageIndexDepths": [
      { "name": "PySide6", "depth": 1 },
      { "name": "kubernetes", "depth": 1 },
      { "name": "boto3", "depth": 1 },
      { "name": "botocore", "depth": 1 },
    ],
    "python.analysis.typeCheckingMode": "standard",
    "python.defaultInterpreterPath": ".venv/bin/python",
    "python.experiments.enabled": false,
    "python.terminal.activateEnvironment": true,
    "python.terminal.useEnvFile": true,
    // Discovering tests starts one pytest per folder when the window opens, and
    // each imports PySide6; the tests are run by hand, one file at a time
    "python.testing.autoTestDiscoverOnSaveEnabled": false,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": false,
    "ruff.enable": true,
    "ruff.format.enable": true,
    "ruff.lint.enable": true,

    // ── Shell / Make ──────────────────────────────────────────────────────
    "makefile.configureOnOpen": false,
    "shellcheck.customArgs": ["--severity=warning", "--external-sources"],
    "shfmt.executableArgs": ["--indent", "2", "--case-indent"],

    // ── Frontend (Nuxt) ───────────────────────────────────────────────────
    "eslint.useFlatConfig": true,
    "eslint.workingDirectories": [{ "pattern": "modules/front-*" }],
    "js/ts.preferences.importModuleSpecifier": "non-relative",

    // ── Performance: keep generated/vendored trees out of watch + search ──
    // Each of these keys appears once: in a JSON file the last duplicate wins
    // and the others are silently lost.
    "files.exclude": {
      "**/*.git": true,
      "**/*.pyc": true,
      "**/*.pyo": true,
      "**/__pycache__": true,
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/.mypy_cache/**": true,
      "**/.nuxt/**": true,
      "**/.output/**": true,
      "**/.pytest_cache/**": true,
      "**/.ruff_cache/**": true,
      "**/.venv/**": true,
      "**/__pycache__/**": true,
      "**/build/**": true,
      "**/coverage/**": true,
      "**/dist/**": true,
      "**/node_modules/**": true,
      "**/vendor/**": true,
    },
    // ripgrep must never follow a link: one that points at "/" (as the Z: drive
    // of a Wine prefix does) makes it walk the whole disk
    "search.followSymlinks": false,
    "search.exclude": {
      "**/*.egg-info": true,
      "**/.git": true,
      "**/.nuxt": true,
      "**/.output": true,
      "**/.venv": true,
      "**/bower_components": true,
      "**/build": true,
      "**/bun.lock": true,
      "**/coverage": true,
      "**/coverage.xml": true,
      "**/dist": true,
      "**/node_modules": true,
      "**/uv.lock": true,
      "**/vendor": true,
      "**/venv": true,
    },

    // The Tailwind server crawls the folders for its config and CSS: it does not
    // need the virtual environments or the builds (this project has no Tailwind)
    "tailwindCSS.files.exclude": [
      "**/.git/**",
      "**/.venv/**",
      "**/build/**",
      "**/dist/**",
      "**/node_modules/**",
      "**/vendor/**",
    ],

    // ── Git ───────────────────────────────────────────────────────────────
    "git.autofetch": true,
    "git.autofetchPeriod": 900,
    "git.untrackedChanges": "mixed",

    // ── AI assistants ─────────────────────────────────────────────────────
    "chat.agentFilesLocations": {
      ".": true,
      "../..": true,
    },
    "chat.tools.terminal.autoApprove": {
      "git add": true,
    },
    "chat.useAgentsMdFile": true,
    "github.copilot.enable": {
      "*": true,
      "plaintext": true,
      "markdown": true,
      "scminput": false,
    },
  },
  "extensions": {
    "recommendations": [
      "carlos-algms.make-task-provider",
      "charliermarsh.ruff",
      "davidanson.vscode-markdownlint",
      "dbaeumer.vscode-eslint",
      "esbenp.prettier-vscode",
      "formulahendry.docker-explorer",
      "github.vscode-github-actions",
      "mkhl.shfmt",
      "ms-python.debugpy",
      "ms-python.vscode-pylance",
      "ms-vscode.makefile-tools",
      "tamasfe.even-better-toml",
      "timonwong.shellcheck",
      "unjinjang.rest-api-client",
      "vue.volar",
    ],
  },
}
